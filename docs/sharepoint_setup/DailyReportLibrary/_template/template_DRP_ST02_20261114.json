        {
          "id": "value",
          "label": {
            "vi": "Chỉ số đánh giá",
            "en": "Value"
          },
          "reset": true,
          "default": "SV | EV | AC",
          "align": "center",
          "width": 30
        }
      ],
      "rows": [
        {
          "id": "r1",
          "cells": {
            "am": "Nắng",
            "pm": "Nắng",
            "night": "Nắng",
            "hrsLost": 0,
            "value": "SV | EV | AC"
          }
        }
      ]
    },
