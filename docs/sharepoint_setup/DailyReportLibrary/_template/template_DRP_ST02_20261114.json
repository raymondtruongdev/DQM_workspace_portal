        "short": "Thời tiết"
      },
      "single": true,
      "showSummary": false,
      "columns": [
        {
          "id": "am",
          "label": {
            "vi": "Sáng 08h-16h",
            "en": "Morning"
          },
          "type": "select",
          "catalog": "weather",
          "noNone": true,
          "reset": true,
          "default": "Nắng",
          "align": "center",
          "width": 13
        },
        {
          "id": "pm",
          "label": {
            "vi": "Chiều 16h-24h",
            "en": "Afternoon"
          },
          "type": "select",
          "catalog": "weather",
          "noNone": true,
          "reset": true,
          "default": "Nắng",
          "align": "center",
          "width": 13
        },
        {
          "id": "night",
          "label": {
            "vi": "Tối 00h-08h",
            "en": "Night"
          },
          "type": "select",
          "catalog": "weather",
          "noNone": true,
          "reset": true,
          "default": "Nắng",
          "align": "center",
          "width": 13
